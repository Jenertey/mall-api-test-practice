{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/product-page.schema.json",
  "title": "Mall product page",
  "type": "object",
  "required": ["code", "data"],
  "properties": {
    "code": { "const": 200 },
    "data": {
      "type": "object",
      "required": ["list", "total", "pageNum", "pageSize"],
      "properties": {
        "list": {
          "type": "array",
          "items": { "$ref": "product.schema.json" }
        },
        "total": { "type": "integer", "minimum": 0 },
        "pageNum": { "type": "integer", "minimum": 1 },
        "pageSize": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
